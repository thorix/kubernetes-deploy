# Frigate NVR Configuration — EXAMPLE / TEMPLATE
# https://docs.frigate.video/configuration/
#
# This is a public, sanitized template. The live config is location-specific
# (camera IPs, stream URLs, retention tuning) and is NOT shipped in this repo.
#
# How it's wired:
#   frigate/deploy.yaml injects config.yml via a Helm fileParameter whose path
#   is "$config/<cluster>/frigate/config.yml" — i.e. it's resolved from the
#   private config repo (the ApplicationSet adds it as the "$config" ref source).
#
# To run your own:
#   1. Copy this file to <your-config-repo>/<cluster>/frigate/config.yml
#   2. Fill in your cameras, streams, and retention.
#   3. Point frigate/deploy.yaml's fileParameter path at your cluster, e.g.
#        path: $config/<cluster>/frigate/config.yml
#   4. Provide credentials via the Vault-synced secrets referenced in values.yaml
#      (FRIGATE_RTSP_USER / FRIGATE_RTSP_PASSWORD, FRIGATE_DOORBELL_* etc.).

mqtt:
  enabled: false

detectors:
  cpu:
    type: cpu
    num_threads: 4

ffmpeg:
  hwaccel_args: []

# Objects tracked globally. Frigate's default is ["person"] alone.
#
# Alerts and detections are separate review tiers. Put a label in
# `detections.labels` to make it recorded and searchable, and in
# `alerts.labels` only when you actually want to be told about it. A camera
# that can see a public street should NOT alert on `car` until zones exist to
# scope the alert to your own driveway via `required_zones` -- otherwise every
# passing vehicle raises an alert.
objects:
  track:
    - person
    - car

review:
  alerts:
    labels:
      - person
  detections:
    labels:
      - person
      - car

record:
  enabled: true
  retain:
    # Baseline retention for ALL motion footage. Tune per-cluster to your
    # NVR storage. (e.g. 3 for a few days, 60 for ~2 months.)
    days: 7
    mode: motion
  alerts:
    retain:
      days: 14
      mode: active_objects
  detections:
    retain:
      days: 14
      mode: active_objects

snapshots:
  enabled: true
  retain:
    default: 14

# Optional restreaming layer (e.g. for doorbells exposing non-RTSP feeds).
go2rtc:
  streams:
    example_doorbell:
      - "ffmpeg:http://CAMERA_IP/flv?port=1935&app=bcs&stream=channel0_main.bcs&user={FRIGATE_DOORBELL_USER}&password={FRIGATE_DOORBELL_PASSWORD}#video=copy#audio=copy#audio=opus"

cameras:
  example_camera:
    enabled: true
    ffmpeg:
      inputs:
        # High-res stream for recording
        - path: rtsp://{FRIGATE_RTSP_USER}:{FRIGATE_RTSP_PASSWORD}@CAMERA_IP:554/cam/realmonitor?channel=1&subtype=0
          roles:
            - record
        # Low-res substream for detection
        - path: rtsp://{FRIGATE_RTSP_USER}:{FRIGATE_RTSP_PASSWORD}@CAMERA_IP:554/cam/realmonitor?channel=1&subtype=1
          roles:
            - detect
    # detect.enabled defaults to FALSE in Frigate 0.17. If you never set it, the
    # cameras record but no object detection ever runs and the Alerts and
    # Detections tabs stay permanently empty.
    detect:
      enabled: true
      width: 1280
      height: 720
      fps: 5

    motion:
      # Mask anything that changes on its own every frame -- a burned-in
      # timestamp overlay is the usual culprit, since a repainting clock reads
      # as perpetual motion and wakes the detector on an empty scene.
      #
      # Coordinates are normalized (0-1) "x1,y1,x2,y2,...". Keep every value
      # strictly BELOW 1.000: Frigate decides normalized-vs-pixel with a string
      # comparison (`x > "1.0"`), so "1.000" sorts high, the mask is misread as
      # pixel coordinates, and config parsing fails. Use 0.999 for a full edge.
      #
      # Measure before you mask. Masking a tree "because trees move" can blind a
      # third of the frame for nothing; diff a few frames first and mask only
      # what actually changes.
      mask:
        - 0.700,0.000,0.999,0.000,0.999,0.100,0.700,0.100

    objects:
      filters:
        person:
          # Fractional values (0.000001-0.99) are a share of the detect frame;
          # integers are raw pixels. Start low -- an over-large min_area drops
          # real objects silently, with nothing in the UI to say it happened --
          # and tune it against the area distribution of real events.
          min_area: 0.001
        car:
          min_area: 0.002
